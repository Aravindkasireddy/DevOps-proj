services:
  api:
    image: {{ app_image }}
    restart: unless-stopped
    ports:
      - "{{ app_port }}:8000"
    environment:
      APP_ENV: production
      DATABASE_URL: {{ database_url | default('postgresql+asyncpg://finenterprise:secret@127.0.0.1:5432/fin_enterprise_assets') }}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"]
      interval: 30s
      timeout: 5s
      retries: 3

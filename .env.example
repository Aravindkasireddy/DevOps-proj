# Application
APP_ENV=development
APP_NAME=fin-enterprise-api
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://finenterprise:fin_enterprise_secret@postgres:5432/fin_enterprise_assets
POSTGRES_USER=finenterprise
POSTGRES_PASSWORD=fin_enterprise_secret
POSTGRES_DB=fin_enterprise_assets

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# PROMETHEUS_MULTIPROC_DIR only if running multiple uvicorn workers (not needed for docker compose)

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# CI/CD secrets (set in GitHub Actions, not committed)
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
# AWS_ROLE_ARN=
# GCP_WORKLOAD_IDENTITY_PROVIDER=
